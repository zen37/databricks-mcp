# Copy this file to .env for local development (used by both mcp_server/ and
# dashboard/ - copy it into whichever folder you're running from, or export
# these as real env vars).
#
# The backing weather API (Open-Meteo) needs NO API key and NO signup, so
# there is nothing secret here - these are just endpoint/unit/threshold
# defaults. In production on Databricks Apps these same values are set via
# each app's app.yaml.

# --- Weather API endpoints (Open-Meteo, keyless) ---
WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast
GEOCODING_API_BASE=https://geocoding-api.open-meteo.com/v1/search

# --- Units ---
WEATHER_TEMP_UNIT=fahrenheit   # or "celsius"
WEATHER_WIND_UNIT=mph          # or "kmh", "ms", "kn"
WEATHER_PRECIP_UNIT=inch       # or "mm"

# --- Recommendation thresholds (used by the prediction tools) ---
UMBRELLA_PROB_THRESHOLD=40     # % chance of precipitation to recommend an umbrella
UMBRELLA_PRECIP_THRESHOLD=0.1  # precipitation amount (in WEATHER_PRECIP_UNIT) to recommend an umbrella
JACKET_TEMP_THRESHOLD=50       # low temp (in WEATHER_TEMP_UNIT) below which to suggest a jacket
WINDY_THRESHOLD=25             # max wind (in WEATHER_WIND_UNIT) above which to flag "windy"

# --- Dashboard only ---
DEFAULT_LOCATION=Chicago

# --- If you swap in a KEYED provider (e.g. WeatherAPI.com) ---
# Do NOT put the real key here or commit it. Store it as a Databricks secret
# and read it with the _secret()/WorkspaceClient().secrets.get_secret()
# pattern (see the note in mcp_server/weather_broker.py). Example env wiring:
# WEATHER_SECRET_SCOPE=weather
# WEATHER_API_KEY_SECRET_KEY=api-key
